        ".write": "auth != null && (auth.token.email === 'omer@lgs.local' || auth.token.email === 'saldanli@istanbul.edu.tr')",
        "$date": {
          ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
