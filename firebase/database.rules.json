            ".validate": "$subj.matches(/^(matematik|turkce|fen|sosyal|ingilizce|din|deneme)$/) && newData.hasChildren(['total', 'correct'])",
            "total": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3000" },
            "correct": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('total').val()" },
